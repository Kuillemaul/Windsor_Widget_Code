+    def _capture_table_view_state(self, table):
+        """Capture viewport position separately from the selected row.
+
+        A user may leave a row selected and then scroll elsewhere to inspect the
+        sheet.  Live refreshes must preserve that viewport instead of dragging
+        the hidden selected row back into the middle of the screen.
+        """
+        if table is None:
+            return {}
+        state = {
+            "current_column": table.currentColumn(),
+        }
+        try:
+            state["vertical_scroll"] = table.verticalScrollBar().value()
+        except Exception:
+            state["vertical_scroll"] = 0
+        try:
+            state["horizontal_scroll"] = table.horizontalScrollBar().value()
+        except Exception:
+            state["horizontal_scroll"] = 0
+        return state
+
+    def _restore_table_view_state(self, table, state):
+        """Restore the saved viewport after selection restoration has run."""
+        if table is None or not state:
             return
+        try:
+            vertical = table.verticalScrollBar()
+            vertical.setValue(max(vertical.minimum(), min(vertical.maximum(), int(state.get("vertical_scroll", 0)))))
+        except Exception:
+            pass
+        try:
+            horizontal = table.horizontalScrollBar()
+            horizontal.setValue(max(horizontal.minimum(), min(horizontal.maximum(), int(state.get("horizontal_scroll", 0)))))
+        except Exception:
+            pass
+
+    def _restore_row_selection(self, table, key_text, key_column=0, current_column=None):
+        if table is None or not key_text:
+            return False
         target = key_text.strip().upper()
         for row in range(table.rowCount()):
             item = table.item(row, key_column)
             text = (item.text() or "").strip().upper() if item is not None else ""
             if text != target:
                 continue
+            target_column = key_column if current_column is None else int(current_column)
+            target_column = max(0, min(table.columnCount() - 1, target_column))
             table.selectRow(row)
-            table.setCurrentCell(row, key_column)
-            if item is not None:
-                table.scrollToItem(item, QAbstractItemView.PositionAtCenter)
-            return
+            table.setCurrentCell(row, target_column)
+            # Do not call scrollToItem here.  The viewport is restored separately
+            # so a background refresh never recentres an off-screen selection.
+            return True
+        return False
 
